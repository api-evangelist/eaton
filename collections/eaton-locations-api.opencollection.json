{
  "opencollection": "1.0.0",
  "info": {
    "name": "Eaton Smart Breaker Authorization Locations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.em.eaton.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.em.eaton.com/api/v1/locations",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Locations"
        },
        {
          "info": {
            "name": "Get Location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.em.eaton.com/api/v1/locations/:locationId",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Location"
        }
      ]
    }
  ],
  "bundled": true
}