{
  "opencollection": "1.0.0",
  "info": {
    "name": "Eaton Smart Breaker Authorization EV Only API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.em.eaton.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "EV Only",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List EV Charging Sessions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.em.eaton.com/api/v1/ev/:deviceId/sessions",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List EV Charging Sessions"
        },
        {
          "info": {
            "name": "Get EV Charging Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.em.eaton.com/api/v1/ev/:deviceId/sessions/:sessionId",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path"
              },
              {
                "name": "sessionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get EV Charging Session"
        }
      ]
    }
  ],
  "bundled": true
}